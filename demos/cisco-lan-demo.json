        "name": "1. PC → Server · ARP แล้ว Ping",
        "source": "office-pc1-presentation",
        "target": "office-server-presentation",
        "protocol": "ICMP",
        "ttl": 64,
        "destinationPort": 443,
        "payloadBytes": 32,
        "expected": "success",
        "note": "",
