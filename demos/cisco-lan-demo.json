  "template": {
    "id": "cisco-lan-demo",
    "name": "01 · Cisco LAN — Ping และ ARP",
    "useCase": "อธิบาย Port-to-Port, ARP และ ICMP ขาไป/ขากลับใน LAN",
    "checklist": [
      "แนะนำรุ่นจริงและพอร์ต G1/0/2 → Eth0 บนผัง",
      "เปิด Cisco CLI: show running-config และ show ip interface brief ของ R1-LAN",
      "รัน PC → Server ดู ARP request/reply ตามด้วย ICMP echo/reply",
      "รันสาย Server ขาด คาดว่า Failed แล้วกลับมารันข้อแรกให้ผ่านอีกครั้ง"
    ],
    "mode": "Realtime",
    "scenarios": [
