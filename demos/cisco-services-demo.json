  "template": {
    "id": "cisco-services-demo",
    "name": "04 · Services — HTTP / TCP / UDP",
    "useCase": "เปรียบเทียบ TCP handshake, HTTP request/response และ UDP datagram",
    "checklist": [
      "เปิด CLI ของ SW1-LAN แสดง access VLAN 10 ที่ตั้งไว้",
      "รัน HTTP เพื่อดู TCP handshake ตามด้วย HTTP request/response",
      "รัน TCP 5432 และ UDP 53 เทียบลำดับ packet; UDP นี้ไม่ใช่ DNS resolver",
      "รัน TCP 22 ให้ Failed เพราะไม่มี service แล้วตรวจ Services ของ Database"
    ],
    "mode": "Realtime",
    "scenarios": [
      {
        "id": "service-http",
        "name": "1. HTTP · request และ response",
        "source": "office-pc1-presentation",
        "target": "office-server-presentation",
        "protocol": "HTTP",
        "ttl": 64,
        "destinationPort": 80,
        "payloadBytes": 32,
        "expected": "success",
        "note": "",
        "disabledEdges": [],
        "enabledEdges": []
      },
      {
        "id": "service-tcp",
        "name": "2. Database · TCP 5432 handshake",
        "source": "office-pc1-presentation",
        "target": "service-db-presentation",
        "protocol": "TCP",
        "ttl": 64,
        "destinationPort": 5432,
        "payloadBytes": 32,
        "expected": "success",
        "note": "",
        "disabledEdges": [],
        "enabledEdges": []
      },
      {
        "id": "service-udp",
        "name": "3. UDP 53 · ไม่มี TCP handshake",
        "source": "office-pc1-presentation",
        "target": "service-udp-presentation",
        "protocol": "UDP",
        "ttl": 64,
        "destinationPort": 53,
        "payloadBytes": 32,
        "expected": "success",
        "note": "UDP transport เท่านั้น ไม่ได้ resolve DNS records",
        "disabledEdges": [],
        "enabledEdges": []
      },
      {
        "id": "service-closed",
        "name": "4. TCP 22 ไม่มี service · ควร Failed",
        "source": "office-pc1-presentation",
        "target": "service-db-presentation",
        "protocol": "TCP",
        "ttl": 64,
        "destinationPort": 22,
        "payloadBytes": 32,
        "expected": "failed",
        "note": "",
        "disabledEdges": [],
        "enabledEdges": []
      }
    ]
