{
  "name": "netaxis-topology",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env src/server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.js",
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "test": "npm run test:server && npm run test:cloud && npm run test:client",
    "check": "npm run build && npm test",
    "test:server": "node --test --test-concurrency=1 tests/core.test.js tests/api.test.js tests/security.test.js tests/restart.test.js tests/client-utils.test.js tests/planning.test.js tests/planning-api.test.js tests/dev-proxy.test.js tests/simulator.test.js tests/network-lab.test.js tests/templates.test.js tests/templates-api.test.js tests/room-expiry.test.js tests/workspaces.test.js tests/deployment.test.js tests/community.test.js",
    "test:client": "vitest run",
    "verify:deployment": "node scripts/check-deployment.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "recover-owner": "node --env-file-if-exists=.env scripts/recover-owner.js",
    "probe": "node --env-file=.env.probe scripts/probe-agent.js",
    "test:cloud": "node --liftoff-only --wasm-num-compilation-tasks=1 --test-isolation=none --test tests/cloud.test.js"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "better-sqlite3": "^11.7.0",
    "cookie": "^2.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^5.0.9",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
