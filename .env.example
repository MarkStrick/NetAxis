# Copy to .env on the server. Never commit real secrets.
# For Vercel + Neon use .env.vercel.example instead; no separate backend is needed.
# For self-hosting both together, keep them on the same origin as shown here.
DOMAIN=netaxis.example.com
PUBLIC_ORIGIN=https://netaxis.example.com
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=loopback
DATA_DIR=./data
BACKUP_DIR=./backups
